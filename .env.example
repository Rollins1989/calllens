# LLM provider for the LLM-as-judge evaluator and the voice agent.
# Leave unset to run fully offline with the built-in mock provider
# (deterministic, keyword-based judging - good for CI and demos).
LLM_PROVIDER=mock            # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# STT / TTS providers for the Version 2 voice pipeline.
# Leave unset to use the mock STT/TTS (echoes scripted demo audio).
STT_PROVIDER=mock            # mock | openai_whisper
TTS_PROVIDER=mock            # mock | openai_tts | elevenlabs
ELEVENLABS_API_KEY=

# Storage
DATABASE_URL=sqlite:///./calllens.db

# Scoring
DEFAULT_BOT_TYPE=appointment_bot
